# Copy to .env. Never commit .env.
POSTGRES_PASSWORD=change-me
# 32 random bytes, base64:   openssl rand -base64 32
# LOSING THIS KEY MAKES STORED PROVIDER CREDENTIALS UNRECOVERABLE. Back it up separately from the database.
PLATFORM_MASTER_KEY=
# >= 32 chars:               openssl rand -base64 48
JWT_SECRET=
# Creates the first admin only when the users table is empty. Remove after first login if you prefer.
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_PASSWORD=
# Only if the dashboard is served from a different origin (dev: http://localhost:5173)
# CORS_ORIGIN=

# Mission workers (the API embeds one by default; set WORKER_EMBEDDED=false if you run only separate workers)
# WORKER_EMBEDDED=true
# WORKER_CONCURRENCY=4
# WORKER_LEASE_MS=60000   # a task whose worker dies is retried after this long
# WORKER_POLL_MS=500
